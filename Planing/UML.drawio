        <mxCell id="9PxguVdvIXVfPsXIymxn-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="CompanionPlants are plants that are good or bad to plant next to each other because they grant benefits&lt;div&gt;(for example tomatos and basil)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;They are saved in the DB with the two familiy ids and a reason for why they are CompanionPlants&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;What plants are compatible is based on the family not on every plant itself&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Because for example all tomatos benefit from basil as a companion not just&amp;nbsp;Beefsteak Tomatoes&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="200" x="1570" y="1024.8600000000001" as="geometry" />
        </mxCell>
        <mxCell id="9PxguVdvIXVfPsXIymxn-30" edge="1" parent="1" source="9PxguVdvIXVfPsXIymxn-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=none;endFill=0;" target="9PxguVdvIXVfPsXIymxn-22">
